{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Права по умолчанию для главного окна WinApp",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "os:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://vellin.ru/*" },
        { "url": "http://localhost:3001/*" }
      ]
    }
  ]
}
