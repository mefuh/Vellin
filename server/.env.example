DATABASE_URL=postgresql://vellin:vellin@localhost:5432/vellin
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars-please
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
WS_TICKET_TTL_SEC=60
# Каталог для загруженных файлов (аватары). В Docker монтируется на volume.
UPLOADS_DIR=./uploads
# Публичный базовый адрес сервиса без завершающего слэша (напр. https://vellin.ru).
# Задаёт АБСОЛЮТНЫЕ URL загруженных файлов и адреса в /api/config — нужно нативным
# клиентам (у них нет origin). Пусто → относительные пути как раньше (веб-совместимо).
PUBLIC_BASE_URL=
# Минимальные версии клиентов (semver) для force-update. Пусто = гейтинг выключен.
# Клиент шлёт X-App-Platform + X-App-Version; ниже минимума → 426 Upgrade Required.
MIN_APP_VERSION_WEB=
MIN_APP_VERSION_WINDOWS=
MIN_APP_VERSION_MACOS=
MIN_APP_VERSION_IOS=
MIN_APP_VERSION_ANDROID=
# Автообновление Windows-клиента: последняя версия + URL установщика. Обе заданы
# → /api/config отдаёт данные обновления, клиенты со старой версией предлагают
# обновиться. WINAPP_UPDATE_MANDATORY=1 делает обновление обязательным.
WINAPP_LATEST_VERSION=
WINAPP_DOWNLOAD_URL=
WINAPP_UPDATE_MANDATORY=0
# Optional. JSON-encoded RTCIceServer[] appended to the default Google STUN.
# Example: ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
ICE_SERVERS=

# TURN (coturn) для прохождения симметричного NAT/CGNAT — без него звонки между
# разными сетями не устанавливаются. Сервер выдаёт клиенту ЭФЕМЕРНЫЕ креды
# (TURN REST: username=время-истечения, credential=HMAC-SHA1 по TURN_SECRET).
# TURN_SECRET должен совпадать со static-auth-secret в /etc/turnserver.conf.
# TURN_URLS — список turn:-URL через запятую.
TURN_SECRET=
TURN_URLS=turn:vellin.ru:3478?transport=udp,turn:vellin.ru:3478?transport=tcp
# TURN_TTL_SEC=3600

# Email главного администратора. Пользователь с этим email при логине получит
# isAdmin=true и доступ к админ-панели /admin (REST: /api/admin/*).
# Без значения админ-панель никому недоступна.
ADMIN_EMAIL=

# Токен kinopoisk.dev для поиска фильмов/сериалов (избранное в профиле).
# Бесплатно у бота @kinopoiskdev_bot в Telegram. Без значения поиск отключён.
KINOPOISK_TOKEN=
